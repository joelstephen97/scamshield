{
  "name": "parry",
  "version": "0.8.0",
  "description": "On-device scam & phishing detection for Chromium and Firefox.",
  "private": true,
  "license": "GPL-3.0-or-later",
  "author": "Joel Stephen <jojostev@gmail.com> (https://github.com/joelstephen97)",
  "homepage": "https://joelstephen97.github.io/parry/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joelstephen97/parry.git"
  },
  "bugs": {
    "url": "https://github.com/joelstephen97/parry/issues"
  },
  "keywords": [
    "browser-extension",
    "chrome-extension",
    "firefox-addon",
    "phishing",
    "scam",
    "anti-phishing",
    "security",
    "privacy",
    "on-device",
    "manifest-v3"
  ],
  "type": "commonjs",
  "scripts": {
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test": "node --test \"tests/unit/**/*.test.js\" && playwright test",
    "build": "node scripts/build.js",
    "bundle:models": "node scripts/bundle-models.js",
    "build:brands": "node tools/build-brand-hashes.js",
    "measure:icon-fp": "node tools/measure-icon-fp.js",
    "gen:parity": "node scripts/gen-parity.js",
    "screenshots": "node tools/screenshots.js",
    "promo": "node tools/promo.js",
    "crawl:pages": "node scripts/crawl-pages.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "linkedom": "^0.18.13"
  },
  "engines": {
    "node": ">=18"
  }
}
