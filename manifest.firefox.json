{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "version": "0.7.1",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "permissions": ["storage", "declarativeNetRequest", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "browser_specific_settings": { "gecko": { "id": "scamshield@joel.dev", "strict_min_version": "128.0" } },
  "background": { "scripts": ["engine/constants.js","engine/trust.js","engine/features.js","engine/image_hash.js","engine/brand_icons.js","engine/report_payload.js","engine/engagement.js","ui/reasons.js","background/stats.js","background/service_worker.js"] },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "js": ["engine/constants.js","engine/trust.js","model/url-model.js","engine/features.js","engine/heuristics.js","engine/techscam_rules.js","engine/clickfix_rules.js","engine/fakeupdate_rules.js","engine/shop_rules.js","engine/verdict.js","ui/reasons.js","engine/url_model.js","engine/page_features.js","model/page-content.js","engine/page_model.js","engine/image_hash.js","content/actions.js","content/content_script.js"],
      "css": ["content/content.css"]
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["engine/constants.js","engine/wallet_rules.js","engine/clipboard_rules.js","engine/privacy_rules.js","content/main_world_guard.js","content/detectors/wallet.js","content/detectors/clipboard.js","content/detectors/techscam.js","content/detectors/privacy.js"]
    }
  ],
  "declarative_net_request": { "rule_resources": [ { "id": "blocklist", "enabled": true, "path": "rules/blocklist.json" } ] },
  "icons": { "16": "assets/icons/icon16.png","32":"assets/icons/icon32.png","48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png" },
  "action": { "default_title": "ScamShield", "default_popup": "popup.html", "default_icon": { "16": "assets/icons/icon16.png","32":"assets/icons/icon32.png","48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png" } },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
