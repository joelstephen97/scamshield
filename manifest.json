{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "version": "0.8.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "121",
  "permissions": ["storage", "declarativeNetRequest", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background/sw.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "js": [
        "engine/constants.js",
        "engine/trust.js",
        "model/url-model.js",
        "engine/features.js",
        "engine/heuristics.js",
        "engine/techscam_rules.js",
        "engine/clickfix_rules.js",
        "engine/fakeupdate_rules.js",
        "engine/shop_rules.js",
        "engine/verdict.js",
        "ui/reasons.js",
        "engine/url_model.js",
        "engine/page_features.js",
        "model/page-content.js",
        "engine/page_model.js",
        "engine/image_hash.js",
        "content/actions.js",
        "content/content_script.js"
      ],
      "css": ["content/content.css"]
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "run_at": "document_start",
      "world": "MAIN",
      "js": [
        "engine/constants.js",
        "engine/wallet_rules.js",
        "engine/clipboard_rules.js",
        "engine/privacy_rules.js",
        "content/main_world_guard.js",
        "content/detectors/wallet.js",
        "content/detectors/clipboard.js",
        "content/detectors/techscam.js",
        "content/detectors/privacy.js"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "blocklist", "enabled": true, "path": "rules/blocklist.json" }
    ]
  },
  "icons": { "16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png" },
  "action": {
    "default_title": "Parry",
    "default_popup": "popup.html",
    "default_icon": { "16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png" }
  },
  "options_page": "options.html"
}
