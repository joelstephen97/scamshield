{
  "manifest_version": 3,
  "name": "ScamShield — Scam & Phishing Protection",
  "short_name": "ScamShield",
  "version": "0.4.0",
  "description": "Detects scam and phishing pages on-device and warns you before you get tricked. No browsing data leaves your device.",
  "permissions": ["storage", "declarativeNetRequest", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background/service_worker.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "run_at": "document_idle",
      "js": [
        "engine/constants.js",
        "model/url-model.js",
        "engine/features.js",
        "engine/heuristics.js",
        "engine/techscam_rules.js",
        "engine/verdict.js",
        "engine/url_model.js",
        "content/actions.js",
        "content/content_script.js"
      ],
      "css": ["content/content.css"]
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "run_at": "document_start",
      "world": "MAIN",
      "js": [
        "engine/constants.js",
        "engine/wallet_rules.js",
        "engine/clipboard_rules.js",
        "content/main_world_guard.js",
        "content/detectors/wallet.js",
        "content/detectors/clipboard.js",
        "content/detectors/techscam.js"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "blocklist", "enabled": true, "path": "rules/blocklist.json" }
    ]
  },
  "icons": { "16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png" },
  "action": {
    "default_title": "ScamShield",
    "default_popup": "popup.html",
    "default_icon": { "16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png" }
  },
  "options_page": "options.html"
}
